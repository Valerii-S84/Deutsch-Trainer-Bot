APP_ENV=<development-or-production>
APP_NAME=<deutsch-trainer-bot>

# Telegram
BOT_TOKEN=<telegram-bot-token>
TELEGRAM_WEBHOOK_SECRET=<webhook-secret>
TELEGRAM_WEBHOOK_URL=<webhook-public-url>
TELEGRAM_WEBHOOK_PATH=<telegram-webhook-path>

# Runtime
LOG_LEVEL=<log-level>
BOT_MAX_REQUEST_TIMEOUT=<request-timeout-seconds>

# PostgreSQL
POSTGRES_HOST=<postgres-host>
POSTGRES_PORT=<postgres-port>
POSTGRES_USER=<postgres-user>
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=<postgres-db>
DATABASE_URL=<postgres-async-url>

# Redis
REDIS_URL=<redis-url>

# Quiz Bank API
QUIZ_BANK_API_BASE_URL=<quiz-bank-api-base-url>
QUIZ_BANK_EDGE_API_KEY=<quiz-bank-edge-api-key>
QUIZ_BANK_CONSUMER_ID=<quiz-bank-consumer-id>
QUIZ_BANK_CONSUMER_API_KEY=<quiz-bank-consumer-api-key>
QUIZ_BANK_TIMEOUT_SECONDS=<quiz-bank-timeout-seconds>
QUIZ_BANK_MAX_RETRIES=<quiz-bank-max-retries>

# Payments (configuration-driven, not hardcoded)
PLUS_PRICE_STARS=<plus-price-stars>
PRO_PRICE_STARS=<pro-price-stars>
PLUS_DURATION_DAYS=<plus-duration-days>
PRO_DURATION_DAYS=<pro-duration-days>
TARIFF_PUBLIC_COPY=<tariff-copy-text>

# Entitlements / limits
FREE_DAILY_QUESTION_LIMIT=<free-daily-question-limit>
PLUS_DAILY_QUESTION_LIMIT=<plus-daily-question-limit>
PRO_DAILY_QUESTION_LIMIT=<pro-daily-question-limit>
