# Production environment template.
# Fill values only in protected runtime secret storage; do not commit a materialized env file.

APP_ENV=production
APP_NAME=deutsch-trainer-bot
BOT_IMAGE=<immutable-image-tag>

PUBLIC_DOMAIN=<production-domain-managed-outside-repo>
ACME_EMAIL=<operator-email-managed-outside-repo>

BOT_TOKEN=<protected-telegram-bot-token>
BOT_WEBHOOK_ENABLED=True
BOT_POLLING_ENABLED=False
BOT_MAX_REQUEST_TIMEOUT=30
BOT_GLOBAL_IN_FLIGHT_LIMIT=512
BOT_GLOBAL_IN_FLIGHT_TIMEOUT_SECONDS=0.05
TELEGRAM_WEBHOOK_URL=https://<production-domain-managed-outside-repo>
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=<protected-webhook-secret>
TELEGRAM_WEBHOOK_MAX_CONNECTIONS=40
TELEGRAM_DUPLICATE_UPDATE_TTL_SECONDS=300

POSTGRES_USER=<protected-database-user>
POSTGRES_PASSWORD=<protected-database-password>
POSTGRES_DB=deutsch_trainer
DATABASE_URL=<protected-asyncpg-database-url>
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True
WORKER_DB_POOL_SIZE=10
WORKER_DB_MAX_OVERFLOW=5
WORKER_DB_POOL_TIMEOUT=5
REDIS_URL=<protected-redis-url>
REDIS_MAX_CONNECTIONS=256

QUIZ_BANK_API_BASE_URL=https://<quiz-bank-origin-managed-outside-repo>
QUIZ_BANK_EDGE_API_KEY=<protected-quiz-bank-edge-key>
QUIZ_BANK_CONSUMER_ID=<approved-consumer-id>
QUIZ_BANK_CONSUMER_API_KEY=<protected-quiz-bank-consumer-key>
QUIZ_BANK_TIMEOUT_SECONDS=3
QUIZ_BANK_MAX_RETRIES=2

LOG_LEVEL=INFO
SECURITY_RATE_LIMIT_ENABLED=True
SECURITY_STATE_BACKEND=redis

TELEGRAM_STARS_MODE=prod
PLUS_PRICE_STARS=10
PRO_PRICE_STARS=20
PLUS_DURATION_DAYS=30
PRO_DURATION_DAYS=90
PAYWALL_COOLDOWN_POLICY=none
FREE_DAILY_QUESTION_LIMIT=5
PLUS_DAILY_QUESTION_LIMIT=25
PRO_DAILY_QUESTION_LIMIT=100
ADMIN_TELEGRAM_USER_IDS=<comma-separated-owner-admin-ids>

POSTGRES_BACKUP_DIR=/srv/deutsch-trainer/backups/postgres
BACKUP_ENCRYPTION=age
BACKUP_AGE_RECIPIENT=<age-public-recipient>
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_DELETE_ENABLED=false
