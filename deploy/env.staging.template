# Staging environment template.
# Use safe staging credentials only; do not commit a materialized env file.

APP_ENV=staging
APP_NAME=deutsch-trainer-bot-staging
BOT_IMAGE=<immutable-staging-image-tag>

PUBLIC_DOMAIN=<staging-domain-managed-outside-repo>
ACME_EMAIL=<operator-email-managed-outside-repo>

BOT_TOKEN=<protected-staging-telegram-bot-token>
BOT_WEBHOOK_ENABLED=True
BOT_POLLING_ENABLED=False
BOT_MAX_REQUEST_TIMEOUT=30
BOT_GLOBAL_IN_FLIGHT_LIMIT=512
BOT_GLOBAL_IN_FLIGHT_TIMEOUT_SECONDS=0.05
WEBHOOK_LISTEN_BACKLOG=8192
WEBHOOK_INGRESS_REPLICAS=2
WEBHOOK_INGRESS_UVICORN_WORKERS=1
WEBHOOK_WORKER_REPLICAS=2
ANSWER_PERSIST_WORKER_REPLICAS=2
OUTBOX_WORKER_REPLICAS=2
TELEGRAM_WEBHOOK_URL=https://<staging-domain-managed-outside-repo>
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=<protected-staging-webhook-secret>
TELEGRAM_WEBHOOK_MAX_CONNECTIONS=40
TELEGRAM_DUPLICATE_UPDATE_TTL_SECONDS=300
WEBHOOK_INGRESS_BACKEND=redis_stream
WEBHOOK_INGRESS_STREAM_KEY=dtb:staging:webhook_ingress:updates
WEBHOOK_INGRESS_GROUP_NAME=dtb-staging-webhook-workers
WEBHOOK_INGRESS_DEAD_LETTER_KEY=dtb:staging:webhook_ingress:dead
WEBHOOK_INGRESS_DEDUPE_KEY_PREFIX=dtb:staging:webhook_ingress:dedupe
WEBHOOK_INGRESS_METRICS_KEY_PREFIX=dtb:staging:webhook_ingress:metrics
WEBHOOK_INGRESS_MAX_ATTEMPTS=5
WEBHOOK_INGRESS_WORKER_BATCH_SIZE=50
WEBHOOK_INGRESS_WORKER_PARALLELISM=20
WEBHOOK_INGRESS_READ_BLOCK_MS=1000
WEBHOOK_INGRESS_ENQUEUE_BATCH_SIZE=250
WEBHOOK_INGRESS_ENQUEUE_FLUSH_INTERVAL_MS=2
WEBHOOK_INGRESS_STALE_IDLE_MS=60000
WEBHOOK_INGRESS_PROCESSING_LAG_SAMPLE_SIZE=10000
WEBHOOK_INGRESS_QUEUE_LAG_UNHEALTHY_MS=120000

POSTGRES_USER=<staging-database-user>
POSTGRES_PASSWORD=<protected-staging-database-password>
POSTGRES_DB=deutsch_trainer_staging
DATABASE_URL=<protected-staging-asyncpg-database-url>
DB_CONNECTION_BACKEND=pgbouncer_transaction
DB_PGBOUNCER_MAX_CLIENT_CONN=200
DB_PGBOUNCER_CLIENT_HEADROOM=32
DB_PGBOUNCER_REUSE_APP_CONNECTIONS=False
DB_APP_REPLICA_COUNT=1
DB_WORKER_REPLICA_COUNT=4
DB_WORKER_CLIENT_BUDGET_PER_REPLICA=25
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True
WORKER_DB_POOL_SIZE=10
WORKER_DB_MAX_OVERFLOW=5
WORKER_DB_POOL_TIMEOUT=5
REDIS_URL=<protected-staging-redis-url>
REDIS_MAX_CONNECTIONS=256
REDIS_POOL_TIMEOUT_SECONDS=2
REDIS_WARMUP_CONNECTIONS=256
TRAINING_ANSWER_CACHE_ENABLED=True
TRAINING_ANSWER_CACHE_TTL_SECONDS=600
TRAINING_ANSWER_WRITE_BEHIND_ENABLED=True
ANSWER_PERSIST_STREAM_KEY=dtb:staging:answer_persist:events
ANSWER_PERSIST_GROUP_NAME=dtb-staging-answer-persist-workers
ANSWER_PERSIST_DEAD_LETTER_KEY=dtb:staging:answer_persist:dead
ANSWER_PERSIST_EVENT_KEY_PREFIX=dtb:staging:answer_persist:event
ANSWER_PERSIST_QUESTION_KEY_PREFIX=dtb:staging:answer_persist:question
ANSWER_PERSIST_RESULT_KEY_PREFIX=dtb:staging:answer_persist:result
ANSWER_PERSIST_METRICS_KEY_PREFIX=dtb:staging:answer_persist:metrics
ANSWER_PERSIST_BATCH_SIZE=250
ANSWER_PERSIST_FLUSH_INTERVAL_MS=50
ANSWER_PERSIST_MAX_ATTEMPTS=5
ANSWER_PERSIST_STALE_IDLE_MS=60000
ANSWER_PERSIST_PROCESSING_LAG_SAMPLE_SIZE=10000

QUIZ_BANK_API_BASE_URL=https://<staging-quiz-bank-origin-managed-outside-repo>
QUIZ_BANK_EDGE_API_KEY=<protected-staging-quiz-bank-edge-key>
QUIZ_BANK_CONSUMER_ID=<approved-staging-consumer-id>
QUIZ_BANK_CONSUMER_API_KEY=<protected-staging-quiz-bank-consumer-key>
QUIZ_BANK_TIMEOUT_SECONDS=3
QUIZ_BANK_MAX_RETRIES=2

LOG_LEVEL=INFO
SECURITY_RATE_LIMIT_ENABLED=True
SECURITY_STATE_BACKEND=redis

TELEGRAM_STARS_MODE=test
PLUS_PRICE_STARS=10
PRO_PRICE_STARS=20
PLUS_DURATION_DAYS=30
PRO_DURATION_DAYS=90
PAYWALL_COOLDOWN_POLICY=none
FREE_DAILY_QUESTION_LIMIT=5
PLUS_DAILY_QUESTION_LIMIT=25
PRO_DAILY_QUESTION_LIMIT=100
ADMIN_TELEGRAM_USER_IDS=<comma-separated-staging-admin-ids>

POSTGRES_BACKUP_DIR=/srv/deutsch-trainer-staging/backups/postgres
BACKUP_ENCRYPTION=age
BACKUP_AGE_RECIPIENT=<staging-age-public-recipient>
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_DELETE_ENABLED=false
